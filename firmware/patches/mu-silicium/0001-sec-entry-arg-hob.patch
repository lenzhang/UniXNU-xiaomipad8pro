diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa..e9f9dc7 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,14 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // UniXNU (from uefi-sheng 66421cb): the previous stage may enter with SPSel=0; take exceptions on the stack set up below.
+  msr   SPSel, #1
+  isb
+
+  // Keep x0 for the platform: the DT address a Linux-style boot loader (ABL via BootShim) hands over.
+  adr   x1, ASM_PFX (gSecEntryArg0)
+  str   x0, [x1]
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -61,3 +69,9 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  // First argument of the previous stage, written once at entry
+  .align 3
+  .global ASM_PFX (gSecEntryArg0)
+ASM_PFX (gSecEntryArg0):
+  .quad 0
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index 8d586b3..28b863d 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -18,6 +18,9 @@
 
 #include "Sec.h"
 
+// First argument (x0) of the previous stage, saved by ModuleEntryPoint.S
+extern UINT64  gSecEntryArg0;
+
 #ifndef MDEPKG_NDEBUG
 STATIC
 VOID
@@ -130,6 +133,13 @@ SecMain (VOID)
     return;
   }
 
+  // UniXNU: pass on what the previous stage handed over in x0 (the DT address), for UniXNURamDiskDxe.
+  {
+    UINT64  EntryArg = gSecEntryArg0;
+
+    BuildGuidDataHob (&gSiliciumEntryArgHobGuid, &EntryArg, sizeof (EntryArg));
+  }
+
   // Run Library Cconstructors
   ProcessLibraryConstructorList ();
 
@@ -160,8 +170,9 @@ SecEntry (VOID)
   ArmEnableInstructionCache ();
 
   // Invalidate Stack & UEFI FD D-Cache
-  InvalidateDataCacheRange ((VOID *)FixedPcdGet64 (PcdCPUCoresStackBase), FixedPcdGet32 (PcdCPUCorePrimaryStackSize));
-  InvalidateDataCacheRange ((VOID *)FixedPcdGet64 (PcdFdBaseAddress),     FixedPcdGet32 (PcdFdSize));
+  // Write back, not only invalidate: a plain invalidate could discard gSecEntryArg0 just stored by the entry code.
+  WriteBackInvalidateDataCacheRange ((VOID *)FixedPcdGet64 (PcdCPUCoresStackBase), FixedPcdGet32 (PcdCPUCorePrimaryStackSize));
+  WriteBackInvalidateDataCacheRange ((VOID *)FixedPcdGet64 (PcdFdBaseAddress),     FixedPcdGet32 (PcdFdSize));
 
   // Verify Exception Vector Table
   ASSERT (((UINTN)SecVectorTable & ARM_VECTOR_TABLE_ALIGNMENT) == 0);
