   //
-  // The volume UniXNU was started from wins; then every other volume.
+  // The volume UniXNU was started from wins; then the boot image's RAM payload; then every other volume.
   //
   if (!EFI_ERROR (gBS->HandleProtocol (ImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Self))) {
     Loaded = TryVolume (Config, Self->DeviceHandle);
@@ -1554,8 +1602,17 @@ UniXNUConfigLoad (
   if (!Loaded && (Config->Error[0] == '\0')) {
     Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &Count, &Handles);
     if (!EFI_ERROR (Status)) {
-      for (Index = 0; Index < Count && !Loaded && Config->Error[0] == '\0'; Index++) {
-        Loaded = TryVolume (Config, Handles[Index]);
+      //
+      // UniXNU-piano: pass 0 tries only the RAM payload's volume, pass 1 every other volume in firmware order. The UFS
+      // LUNs are published (UFSDxe is APRIORI) before the RAM disk, so without pass 0 a "fastboot boot" image would boot
+      // the payload of a FAT ESP on UFS instead of its own.
+      //
+      for (Pass = 0; Pass < 2 && !Loaded && Config->Error[0] == '\0'; Pass++) {
+        for (Index = 0; Index < Count && !Loaded && Config->Error[0] == '\0'; Index++) {
+          if (IsRamPayloadVolume (Handles[Index]) == (Pass == 0)) {
+            Loaded = TryVolume (Config, Handles[Index]);
+          }
+        }
       }
 
