+//
+// UniXNU-piano: the vendor node of UniXNURamDiskDxe's block device, the FAT payload a boot image carries as its ramdisk
+// (UniXNURamDiskDxe.c mDevicePath). Its file system handle has this node first: the payload has no partition table.
+//
+STATIC CONST EFI_GUID  mRamPayloadVendorGuid = {
+  0xA9C6827C, 0x1BD8, 0x410C, { 0x88, 0x5A, 0xC4, 0x65, 0x00, 0xF7, 0xD8, 0x36 }
+};
+
+STATIC
+BOOLEAN
+IsRamPayloadVolume (
+  IN EFI_HANDLE  Volume
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Path;
+
+  Path = DevicePathFromHandle (Volume);
+  if ((Path == NULL) || (DevicePathType (Path) != HARDWARE_DEVICE_PATH) || (DevicePathSubType (Path) != HW_VENDOR_DP) ||
+      (DevicePathNodeLength (Path) < sizeof (VENDOR_DEVICE_PATH)))
+  {
+    return FALSE;
+  }
+
+  return CompareGuid (&((VENDOR_DEVICE_PATH *)Path)->Guid, &mRamPayloadVendorGuid);
+}
+
+//
+// UniXNU-piano: name the volume the configuration came from (RAM payload or a partition) in the log.
+//
+STATIC
+VOID
+LogVolume (
+  IN EFI_HANDLE  Volume
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Path;
+  CHAR16                    *Text;
+
+  Path = DevicePathFromHandle (Volume);
+  Text = (Path != NULL) ? ConvertDevicePathToText (Path, FALSE, FALSE) : NULL;
+  UniXNULog ("config: volume %s", (Text != NULL) ? Text : L"(no device path)");
+  if (Text != NULL) {
+    FreePool (Text);
+  }
+}
+
 STATIC
