 		if (trp == NULL) {
 			piano_llcc_island = 0;
 			printf("piano-pm: the LLCC broadcast window does not map: the island slice is not known to be reserved\n");
@@ -246,6 +251,104 @@ piano_llcc_island_ok(void)
 	return piano_llcc_island == 1 || piano_llcc_override == 1;
 }
 
+/* ==== k27 0064 begin: the LLCC island at each decision ==== */
+/*
+ * piano-llcc-island-live=1: ss3 is decided on the two words read at that decision, not on the boot reading above (which comes
+ * before any kext, so a slice PianoA830 programs later, piano-llcc-island=1, stayed "NOT reserved" here). The idle loop reads
+ * them only when every other condition of ss3 holds (piano_s2idle_policy.h piano_pm_pick_domain_island), a suspend at its entry.
+ * Read only, the same two loads as the boot reading, through the window it mapped. Off (the default): the boot reading, as 0061.
+ */
+static uint32_t piano_llcc_live;                  /* piano-llcc-island-live=1 */
+static _Atomic uint64_t piano_llcc_live_reads, piano_llcc_live_reserved;
+static _Atomic uint32_t piano_llcc_live_res, piano_llcc_live_bonus;
+static _Atomic int piano_llcc_live_seen = -1;     /* the last reading's verdict: -1 none, 0 not reserved, 1 reserved */
+static int piano_llcc_live_said = -1;             /* the verdict last put on the console */
+
+/* The two words now (any context, interrupts masked included: two loads); the verdict for ss3. */
+static bool
+piano_llcc_island_now(void)
+{
+	volatile uint32_t *trp = piano_llcc_trp;
+	uint32_t res = 0, bonus = 0;
+	if (trp != NULL) {
+		res = trp[(PIANO_LLCC_ISLAND1 * 64) / 4];
+		bonus = trp[(PIANO_LLCC_ISLAND1 * 64 + 8) / 4];
+	}
+	const bool reserved = trp != NULL && piano_pm_llcc_island_ok(res, bonus);
+	os_atomic_inc(&piano_llcc_live_reads, relaxed);
+	if (reserved) {
+		os_atomic_inc(&piano_llcc_live_reserved, relaxed);
+	}
+	os_atomic_store(&piano_llcc_live_res, res, relaxed);
+	os_atomic_store(&piano_llcc_live_bonus, bonus, relaxed);
+	os_atomic_store(&piano_llcc_live_seen, reserved ? 1 : 0, relaxed);
+	return piano_llcc_ss3_verdict(piano_llcc_override == 1, trp != NULL, res, bonus);
+}
+
+static bool
+piano_llcc_island_cb(void *ctx __unused)
+{
+	return piano_llcc_island_now();
+}
+
+/* ss3's island condition for a decision in thread context (a suspend's level): live, the reading now; else the boot reading. */
+static bool
+piano_llcc_ss3_ok(void)
+{
+	if (piano_llcc_live) {
+		(void)piano_llcc_island_ok();      /* the window (mapped once, with the boot line) */
+		return piano_llcc_island_now();
+	}
+	return piano_llcc_island_ok();
+}
+
+/* Boot: the argument (1 only), and the window mapped first, while that is still allowed (the idle loop cannot map). */
+static void
+piano_llcc_live_init(void)
+{
+	uint32_t on = 0;
+	if (piano_llcc_live || !PE_parse_boot_argn("piano-llcc-island-live", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	(void)piano_llcc_island_ok();
+	piano_llcc_live = 1;
+	printf("piano-pm: LLCC ISLAND1 read again at each ss3 decision (piano-llcc-island-live=1): ss3 follows the slice as it is "
+	    "then (a programming by PianoA830 counts), not the boot reading above%s\n", piano_llcc_trp ? "" : "; the window did not map: never");
+}
+
+/* Thread context (the cpuidle summary, a suspend's entry): a line when the live verdict changed since the last one. */
+static void
+piano_llcc_live_log(const char *who)
+{
+	if (!piano_llcc_live) {
+		return;
+	}
+	const int seen = os_atomic_load(&piano_llcc_live_seen, relaxed);
+	if (!piano_llcc_live_due(seen, &piano_llcc_live_said)) {
+		return;
+	}
+	printf("%s: LLCC ISLAND1 (SCID 12) now %s: reserved ways %#x, bonus ways %#x (read at an ss3 decision; %llu reads, %llu of them "
+	    "reserved): %s\n", who, seen ? "reserved" : "NOT reserved", os_atomic_load(&piano_llcc_live_res, relaxed),
+	    os_atomic_load(&piano_llcc_live_bonus, relaxed), os_atomic_load(&piano_llcc_live_reads, relaxed),
+	    os_atomic_load(&piano_llcc_live_reserved, relaxed), seen ? "ss3 allowed" : "ss3 stays off until it is");
+}
+
+static size_t
+piano_llcc_line(char *buf, size_t len)
+{
+	if (!piano_llcc_live) {
+		return (size_t)snprintf(buf, len, "LLCC island %s", piano_llcc_island < 0 ? "not read" :
+		           piano_llcc_island ? "reserved" : "not reserved");
+	}
+	const int seen = os_atomic_load(&piano_llcc_live_seen, relaxed);
+	return (size_t)snprintf(buf, len, "LLCC island %s (live: %llu reads, %llu reserved, last %#x/%#x; boot %s)", seen < 0 ?
+	           "not read yet" : seen ? "reserved" : "not reserved", os_atomic_load(&piano_llcc_live_reads, relaxed),
+	           os_atomic_load(&piano_llcc_live_reserved, relaxed), os_atomic_load(&piano_llcc_live_res, relaxed),
+	           os_atomic_load(&piano_llcc_live_bonus, relaxed), piano_llcc_island < 0 ? "not read" : piano_llcc_island ? "reserved" :
+	           "not reserved");
+}
+/* ==== k27 0064 end ==== */
+
 static void
 piano_pm_probe(void)
 {
@@ -327,6 +430,10 @@ piano_idle_pick(struct piano_idle_cpu *pc, int cpu, int max, uint64_t now, uint6
 			p.all_until = piano_domain_until(p.all_mask);
 		}
 	}
+	if (max >= 3 && piano_llcc_live) {
+		/* k27 0064: the island read at the ss3 decision itself, and only there */
+		return piano_pm_pick_domain_island(&p, param, piano_llcc_island_cb, NULL);
+	}
 	return piano_pm_pick_domain(&p, param);
 }
 
@@ -524,6 +631,7 @@ piano_cpuidle_tick(thread_call_param_t p0 __unused, thread_call_param_t p1 __unu
 	}
 	piano_rpmh_line(line, sizeof(line));
 	printf("piano-cpuidle: RPMh sleep %s\n", line);
+	piano_llcc_live_log("piano-cpuidle");   /* k27 0064 */
 	uint64_t deadline;
 	clock_interval_to_deadline(piano_cpuidle_period, NSEC_PER_SEC, &deadline);
 	thread_call_enter_delayed(piano_cpuidle_call, deadline);
@@ -546,6 +654,10 @@ piano_cpuidle_format(char *buf, size_t len)
 		n += piano_rpmh_line(buf + n, len > n ? len - n : 0);
 		n += (size_t)snprintf(buf + n, len > n ? len - n : 0, "\n");
 	}
+	if (n + 1 < len && piano_cpuidle_max >= 3) {   /* k27 0064 */
+		n += piano_llcc_line(buf + n, len - n);
+		n += (size_t)snprintf(buf + n, len > n ? len - n : 0, "\n");
+	}
 	return n < len ? n : len - 1;
 }
 
@@ -615,6 +727,7 @@ piano_cpuidle_init(void)
 	if (probe != 0 || level >= 3) {
 		(void)piano_llcc_island_ok();
 	}
+	piano_llcc_live_init();   /* k27 0064 */
 	if (level == 0) {
 		return;
 	}
@@ -626,8 +739,13 @@ piano_cpuidle_init(void)
 		level = PIANO_IDLE_LEVELS - 1;
 	}
 	if (level == 3 && !piano_llcc_island_ok()) {
-		level = 2;
-		printf("piano-cpuidle: level 3 refused (the LLCC island slice is not reserved): level 2\n");
+		if (piano_llcc_live) {
+			printf("piano-cpuidle: level 3 with the LLCC island slice not reserved now: ss3 waits for it (read at each ss3 decision, "
+			    "piano-llcc-island-live=1)\n");
+		} else {
+			level = 2;
+			printf("piano-cpuidle: level 3 refused (the LLCC island slice is not reserved): level 2\n");
+		}
 	}
 	PE_parse_boot_argn("piano-cpuidle-pd", &pd, sizeof(pd));
 	PE_parse_boot_argn("piano-cpuidle-period", &piano_cpuidle_period, sizeof(piano_cpuidle_period));
@@ -747,8 +865,10 @@ _Static_assert(PIANO_WAKE_POWER_KEY == PIANO_PM_WAKE_POWER_KEY && PIANO_WAKE_LID
     PIANO_WAKE_KEYBOARD == PIANO_PM_WAKE_KEYBOARD, "piano_pm.h and piano_pm_policy.h name the wake reasons alike");
 
 static const char *const piano_wake_names[] = {
-	"none", "aborted", "power-key", "lid", "usb", "volume-down", "timer", "irq", "keyboard",
+	"none", "aborted", "power-key", "lid", "usb", "volume-down", "timer", "irq", "keyboard", "cancelled",
 };
+_Static_assert(sizeof(piano_wake_names) / sizeof(piano_wake_names[0]) == PIANO_WAKE_CANCELLED + 1 &&
+    PIANO_WAKE_CANCELLED < 10, "a name and a counter (piano_sleep_reasons) per wake reason");
 
 const char *
 piano_s2idle_reason_name(int reason)
@@ -1103,7 +1223,7 @@ static uint32_t
 piano_sleep_level(void)
 {
 	uint32_t level = piano_sleep_state < PIANO_IDLE_LEVELS ? piano_sleep_state : PIANO_IDLE_LEVELS - 1;
-	if (level == 3 && !piano_llcc_island_ok()) {
+	if (level == 3 && !piano_llcc_ss3_ok()) {   /* k27 0064: live, the island as it is now */
 		level = 2;
 	}
 	if (level > 0 && piano_psci_suspend_features < 0) {
@@ -1213,6 +1333,108 @@ piano_wait_power_release(bool *ipi)
 	}
 }
 
+/* ==== k27 0064 begin: a driver's cancel of the suspend in progress ==== */
+/*
+ * piano-sleep-cancel=1: a driver that cannot take part in this sleep (its hardware would not go down, or not come back) asks
+ * piano_s2idle_cancel(who, why), or IOPMrootDomain's callPlatformFunction("piano-sleep-cancel", who, why) without linking this
+ * kernel, during its kOff (setPowerState) or its PreSleep platform action. The suspend then does not happen: it returns before
+ * the park (or abandons the park, as for a CPU that does not park), the platform wake actions run, every driver is taken up
+ * again and the wake reason is "piano.cancelled". The window (piano_s2idle_policy.h) opens when the root domain starts taking
+ * the drivers down and shuts at the freeze; outside it, or without the argument, the request is refused, logged, and the sleep
+ * goes on as before. piano-sleep-cancel-test=N: the kernel itself asks, as a driver would, at PreSleep of suspend N.
+ */
+static uint32_t piano_sleep_cancel_on;            /* piano-sleep-cancel=1 */
+static uint32_t piano_sleep_cancel_test;          /* piano-sleep-cancel-test=N */
+static struct piano_cancel piano_cancel;
+static SIMPLE_LOCK_DECLARE(piano_cancel_lock, 0);
+
+static boolean_t
+piano_cancel_lock_take(void)
+{
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	simple_lock(&piano_cancel_lock, LCK_GRP_NULL);
+	return istate;
+}
+
+static void
+piano_cancel_lock_drop(boolean_t istate)
+{
+	simple_unlock(&piano_cancel_lock);
+	ml_set_interrupts_enabled(istate);
+}
+
+void
+piano_s2idle_cancel_window(bool fresh)
+{
+	if (!piano_sleep_on) {
+		return;
+	}
+	boolean_t istate = piano_cancel_lock_take();
+	piano_cancel_open(&piano_cancel, piano_sleep_count + 1, fresh);
+	piano_cancel_lock_drop(istate);
+}
+
+bool
+piano_s2idle_cancel_test_due(void)
+{
+	return piano_sleep_on && piano_cancel_test_due(piano_sleep_cancel_test, piano_sleep_count + 1);
+}
+
+int
+piano_s2idle_cancel(const char *who, const char *why)
+{
+	char w[PIANO_CANCEL_WHO], y[PIANO_CANCEL_WHY], first[PIANO_CANCEL_WHO], first_why[PIANO_CANCEL_WHY];
+	piano_cancel_copy(w, sizeof(w), who);
+	piano_cancel_copy(y, sizeof(y), why);
+	if (!piano_sleep_on) {
+		return PIANO_CANCEL_OFF;
+	}
+	boolean_t istate = piano_cancel_lock_take();
+	const int r = piano_cancel_request(&piano_cancel, piano_sleep_cancel_on == 1, w, y);
+	const uint32_t attempt = piano_cancel.attempt, callers = piano_cancel.callers;
+	const uint64_t refused = piano_cancel.refused;
+	memcpy(first, piano_cancel.who, sizeof(first));
+	memcpy(first_why, piano_cancel.why, sizeof(first_why));
+	piano_cancel_lock_drop(istate);
+	if (r == PIANO_CANCEL_TAKEN) {
+		if (callers == 1) {
+			printf("piano-sleep: suspend %u cancelled by %s: %s (piano-sleep-cancel=1): nothing is suspended, the system wakes\n",
+			    attempt, first, first_why);
+		} else {
+			printf("piano-sleep: suspend %u: %s also asks to cancel (%s); already cancelled by %s\n", attempt, w, y, first);
+		}
+	} else if (piano_cancel_refusal_logged(refused)) {
+		printf("piano-sleep: %s asks to cancel the suspend (%s): %s (refusal %llu)\n", w, y, r == PIANO_CANCEL_OFF ?
+		    "not honoured (piano-sleep-cancel=0): the sleep goes on" : r == PIANO_CANCEL_LATE ? "too late (the CPUs are frozen)" :
+		    "no system sleep in progress", refused);
+	}
+	return r;
+}
+
+/* The suspend's own look at the window: SHUT also shuts it (the freeze, or a return before it). True when it is cancelled;
+ * then the first caller's name and reason in WHO / WHY. */
+static bool
+piano_cancel_take(bool shut, char *who, char *why)
+{
+	boolean_t istate = piano_cancel_lock_take();
+	const bool cancelled = shut ? piano_cancel_shut(&piano_cancel) : piano_cancel_pending(&piano_cancel);
+	if (cancelled) {
+		memcpy(who, piano_cancel.who, PIANO_CANCEL_WHO);
+		memcpy(why, piano_cancel.why, PIANO_CANCEL_WHY);
+	}
+	piano_cancel_lock_drop(istate);
+	return cancelled;
+}
+
+static void
+piano_cancel_end(void)
+{
+	boolean_t istate = piano_cancel_lock_take();
+	piano_cancel_close(&piano_cancel);
+	piano_cancel_lock_drop(istate);
+}
+/* ==== k27 0064 end ==== */
+
 static void
 piano_rpmh_log(const char *when, uint32_t n)
 {
@@ -1233,7 +1455,34 @@ piano_s2idle_enter(void (*quiesce)(void), void (*active)(void))
 	thread_block(THREAD_CONTINUE_NULL);
 	const int boot = cpu_number();
 	const uint32_t n = ++piano_sleep_count;
+	/* k27 0064: cancelled already (a driver's kOff or PreSleep): nothing is suspended, nothing armed */
+	char cancel_who[PIANO_CANCEL_WHO], cancel_why[PIANO_CANCEL_WHY];
+	if (piano_cancel_take(true, cancel_who, cancel_why)) {
