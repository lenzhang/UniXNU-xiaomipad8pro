 bsd/kern/kern_exec.c             |   7 +
 osfmk/arm64/machine_routines.c   | 383 +++++++++++++++++++++++++++++--
 osfmk/arm64/piano_guard_policy.h | 233 +++++++++++++++++++
 osfmk/arm64/piano_pm.c           |  51 ++--
 osfmk/arm64/piano_pm.h           |  17 +-
 6 files changed, 655 insertions(+), 53 deletions(-)
 create mode 100644 osfmk/arm64/piano_guard_policy.h

