diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 77739ff..d015c6c 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -967,9 +967,13 @@ ml_read_psci_conduit(void)
  * 10 s and, once the uptime passes the limit, logs and resets through PSCI SYSTEM_RESET on the ADT's conduit (a warm
  * reset: the pstore-console zone survives for Ubuntu to read). The watchdog (Gunyah SMCCC vendor-hyp service, SET_TIME
  * bark/bite in ms <= 32768, CONTROL 3 = enable) is the backstop for hangs and panics that stop the timer: no pet for 32 s
- * resets the tablet. Off without the boot arg (the VM never sets it).
+ * resets the tablet. Off without the boot arg (the VM never sets it). Since k27 0063 the watchdog has one owner (below), and
+ * this is one of its holders.
  */
 #include <kern/thread_call.h>
+#include <kern/processor.h>
+#include <arm64/piano_pm.h>
+#include "piano_guard_policy.h"
 #define GH_WDT_CONTROL  0x86000005ULL
 #define GH_WDT_STATUS   0x86000006ULL
 #define GH_WDT_PING     0x86000007ULL
@@ -977,7 +981,6 @@ ml_read_psci_conduit(void)
 
 static uint64_t piano_reset_after_ns;
 static thread_call_t piano_reset_call;
-static bool piano_wdt_armed;
 
 static uint64_t
 piano_smc(uint64_t fn, uint64_t a1, uint64_t a2)
@@ -991,6 +994,79 @@ piano_smc(uint64_t fn, uint64_t a1, uint64_t a2)
 	return x0;
 }
 
+/*
+ * k27 0063: the Gunyah watchdog has one owner, here. Its holders (piano_guard_policy.h PIANO_WDT_*): piano-reset-after (0056) and
+ * piano-boot-guard (0063) for the whole boot, piano-sleep (0062) from a suspend's entry to 240 s after its wake. The first holder
+ * enables it (STATUS, SET_TIME bark 30 s / bite 32 s, CONTROL 3), the last one out disables it (CONTROL 2), so 0062's end of its
+ * wake window no longer turns off a watchdog another holder still needs. Anyone may ping it (0056's and the guard's thread calls,
+ * 0062's loop while the thread calls are frozen); a ping is a no-op while it is off. Native only (the SMC conduit).
+ */
+static SIMPLE_LOCK_DECLARE(piano_wdt_lock, 0);
+static uint32_t piano_wdt_holders;
+static uint32_t piano_wdt_on;              /* 1: enabled in Gunyah */
+
+bool
+piano_watchdog_hold(uint32_t who)
+{
+	if (ml_psci_conduit != ML_PSCI_CONDUIT_SMC) {
+		return false;
+	}
+	simple_lock(&piano_wdt_lock, LCK_GRP_NULL);
+	piano_wdt_holders |= who;
+	bool on = os_atomic_load(&piano_wdt_on, relaxed) != 0;
+	if (piano_wdt_change(piano_wdt_holders, on) == 1) {
+		on = (int64_t)piano_smc(GH_WDT_STATUS, 0, 0) >= 0 && (int64_t)piano_smc(GH_WDT_SET_TIME, 30000, 32000) == 0 &&
+		    (int64_t)piano_smc(GH_WDT_CONTROL, 3, 0) == 0;
+		os_atomic_store(&piano_wdt_on, on ? 1u : 0u, relaxed);
+	}
+	simple_unlock(&piano_wdt_lock);
+	return on;
+}
+
+void
+piano_watchdog_release(uint32_t who)
+{
+	simple_lock(&piano_wdt_lock, LCK_GRP_NULL);
+	piano_wdt_holders &= ~who;
+	if (piano_wdt_change(piano_wdt_holders, os_atomic_load(&piano_wdt_on, relaxed) != 0) == -1) {
+		(void)piano_smc(GH_WDT_CONTROL, 2, 0);
+		os_atomic_store(&piano_wdt_on, 0u, relaxed);
+	}
+	simple_unlock(&piano_wdt_lock);
+}
+
+void
+piano_watchdog_ping(void)
+{
+	if (os_atomic_load(&piano_wdt_on, relaxed) != 0) {
+		(void)piano_smc(GH_WDT_PING, 0, 0);
+	}
+}
+
+bool
+piano_watchdog_enabled(void)
+{
+	return os_atomic_load(&piano_wdt_on, relaxed) != 0;
+}
+
+uint32_t
+piano_watchdog_holders(void)
+{
+	return os_atomic_load(&piano_wdt_holders, relaxed);
+}
+
+/* PSCI SYSTEM_RESET on the ADT's conduit (a warm reset); returns only if the firmware refused. */
+static void
+piano_psci_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+	if (ml_psci_conduit == ML_PSCI_CONDUIT_SMC) {
+		__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	} else {
+		__asm__ volatile ("hvc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	}
+}
+
 static void
 piano_reset_tick(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
 {
@@ -999,17 +1075,10 @@ piano_reset_tick(thread_call_param_t p0 __unused, thread_call_param_t p1 __unuse
 	if (now >= piano_reset_after_ns) {
 		printf("piano-reset-after: %llu s reached, PSCI SYSTEM_RESET\n", piano_reset_after_ns / NSEC_PER_SEC);
 		delay(200000);
-		register uint64_t x0 __asm__("x0") = 0x84000009ULL;
-		if (ml_psci_conduit == ML_PSCI_CONDUIT_SMC) {
-			__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
-		} else {
-			__asm__ volatile ("hvc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
-		}
+		piano_psci_reset();
 		return;   /* still here: the watchdog (no more pets) takes the tablet down within 32 s */
 	}
-	if (piano_wdt_armed) {
-		(void)piano_smc(GH_WDT_PING, 0, 0);
-	}
+	piano_watchdog_ping();
 	uint64_t deadline;
 	clock_interval_to_deadline(10, NSEC_PER_SEC, &deadline);
 	thread_call_enter_delayed(piano_reset_call, deadline);
@@ -1023,7 +1092,9 @@ piano_reset_tick(thread_call_param_t p0 __unused, thread_call_param_t p1 __unuse
  * 0x20 * APID for reads, read/write channels at 0x0C500000 + 0x1000 * APID; command = opcode << 27 | offset << 4 | (n - 1),
  * status bit 0 done, bits 1-3 error). So every later reset of this boot (the timed one, a panic restart, a watchdog bite)
  * lands in ABL fastboot, where the next RAM image is waiting. Written for XNU from those register facts (the behaviour of
- * Linux's spmi-pmic-arb and of piano-uefi's selector, read as the specification only).
+ * Linux's spmi-pmic-arb and of piano-uefi's selector, read as the specification only). k27 0063's boot guard writes the same
+ * byte: bootloader at EARLY_BOOT, normal again once the boot is healthy; WHO names the writer in the line, and the read-back
+ * must say REASON.
  */
 #define SPMI_CORE       0x0C400000ULL
 #define SPMI_CNFG       0x0C42D000ULL
@@ -1045,7 +1116,7 @@ piano_spmi_wait(volatile uint32_t *status)
 }
 
 static int
-piano_set_restart_reason(uint8_t reason)
+piano_set_restart_reason(uint8_t reason, const char *who)
 {
 	volatile uint32_t *core = (volatile uint32_t *)ml_io_map(SPMI_CORE, 0x3000);
 	volatile uint32_t *cnfg = (volatile uint32_t *)ml_io_map(SPMI_CNFG, 0x1000);
@@ -1085,8 +1156,9 @@ piano_set_restart_reason(uint8_t reason)
 	}
 	obsv[0] = (1u << 27) | (SDAM_REASON << 4);
 	(void)piano_spmi_wait(&obsv[2]);
-	printf("piano-reset-to: SDAM restart reason 0x%02x -> 0x%02x (APID %u)\n", old, (uint8_t)obsv[6], apid);
-	return 0;
+	uint8_t now = (uint8_t)obsv[6];
+	printf("%s: SDAM restart reason 0x%02x -> 0x%02x (APID %u)\n", who, old, now, apid);
+	return (now >> 1) == reason ? 0 : -7;                    /* k27 0063: the read-back must say it */
 }
 
 static void
@@ -1099,21 +1171,290 @@ piano_reset_init(void)
 	piano_reset_after_ns = (uint64_t)secs * NSEC_PER_SEC;
 	char to[16] = "";
 	if (PE_parse_boot_argn("piano-reset-to", to, sizeof(to)) && strcmp(to, "bootloader") == 0) {
-		int err = piano_set_restart_reason(2);
+		int err = piano_set_restart_reason(2, "piano-reset-to");
 		if (err != 0) {
 			printf("piano-reset-to: SDAM write failed (%d); resets return to the installed OS\n", err);
 		}
 	}
-	if ((int64_t)piano_smc(GH_WDT_STATUS, 0, 0) >= 0 &&
-	    (int64_t)piano_smc(GH_WDT_SET_TIME, 30000, 32000) == 0 && (int64_t)piano_smc(GH_WDT_CONTROL, 3, 0) == 0) {
-		piano_wdt_armed = true;
-	}
-	printf("piano-reset-after: reset at %u s, Gunyah watchdog %s\n", secs, piano_wdt_armed ? "armed (32 s bite)" : "not available");
+	bool wdt = piano_watchdog_hold(PIANO_WDT_RESET_AFTER);
+	printf("piano-reset-after: reset at %u s, Gunyah watchdog %s\n", secs, wdt ? "armed (32 s bite)" : "not available");
 	piano_reset_call = thread_call_allocate_with_options(piano_reset_tick, NULL, THREAD_CALL_PRIORITY_KERNEL_HIGH, THREAD_CALL_OPTIONS_ONCE);
 	piano_reset_tick(NULL, NULL);
 }
 STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, piano_reset_init);
 
+/*
+ * k27 0063: piano-boot-guard=SECS, the installed system's way back from a hang (UniXNU-piano docs/boot-guard.md). Booted from the
+ * ESP (no piano-reset-after) nothing armed the watchdog, so a hang in the boot (a stall in the GPU bring-up, say) stayed until
+ * power + volume-down. With the argument:
+ *   - at EARLY_BOOT the PMIC restart reason becomes bootloader (2, 0057's SDAM byte) and the guard holds the watchdog (32 s
+ *     bite), pinged every 10 s by a thread call. Each tick also sends every other running CPU a nop IPI and checks that its
+ *     interrupt count moved since the tick before (piano-boot-guard-cpus=0 skips this): a CPU that took none across two ticks
+ *     (masked, or stalled on the bus) ends the pings and the guard resets through PSCI. So a whole-system hang (no tick), a stuck
+ *     CPU or a panic restart lands in ABL fastboot, where the Mac takes over;
+ *   - at SECS of uptime the health decision: healthy when the exec of piano-boot-guard-exec (launchd unless given; "none": the
+ *     uptime alone) has been seen by then. It runs in the pinging thread call, so it also says that this still runs. Healthy:
+ *     the restart reason goes back to normal (0) and the pings and CPU checks go on, so a later hang restarts the installed
+ *     system. Not healthy: a PSCI reset into ABL fastboot (a boot that never reached userland does not sit there);
+ *   - with piano-reset-after (0056) the guard stays off: that run owns the watchdog and the reason. piano-reset-to=bootloader
+ *     without it: the guard runs and keeps the reason at bootloader when healthy;
+ *   - tests: piano-boot-guard-ping=0 arms and never pings (the bite about 32 s later must land in ABL fastboot);
+ *     piano-boot-guard-test=hang-at=N masks interrupts on every CPU at N s of uptime (before SECS: ABL fastboot; after: the
+ *     installed system).
+ * The decisions are piano_guard_policy.h (UniXNU-piano tooling/k27/piano-guard, host-tested); machdep.piano_boot_guard shows the
+ * state. While 0062's suspend freezes the thread calls, its loop pings the watchdog.
+ */
+#define PIANO_GUARD_PERIOD_S    10u
+
+static int piano_guard_state = PIANO_GUARD_OFF;
+static uint32_t piano_guard_secs, piano_guard_reset_after, piano_guard_hang_at;
+static bool piano_guard_ping = true, piano_guard_cpus = true, piano_guard_keep_reason;
+static bool piano_guard_need_exec;          /* the exec hook looks for the milestone */
+static volatile bool piano_guard_silent;    /* no more pings from here: a stuck CPU, a failed decision, a test hang */
+static char piano_guard_exec_name[PIANO_GUARD_COMLEN + 1] = "launchd";
+static uint64_t piano_guard_milestone_ns;   /* the uptime of the milestone's exec, 0 not seen */
+static int piano_guard_reason = -1, piano_guard_reason_err, piano_guard_stuck = -1;
+static uint64_t piano_guard_decided_ns, piano_guard_last_ns, piano_guard_max_gap_ns, piano_guard_pings;
+static uint32_t piano_guard_irqs[MAX_CPUS];
+static uint8_t piano_guard_quiet[MAX_CPUS];
+static bool piano_guard_poked[MAX_CPUS];
+static thread_call_t piano_guard_call, piano_guard_test_call;
+static uint32_t piano_guard_spin_sync;
+
+static uint64_t
+piano_guard_uptime_ns(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+/* kern_exec, every image activation: the milestone is the first exec whose p_comm is its name. */
+void
+piano_boot_guard_exec(const char *comm)
+{
+	if (!piano_guard_need_exec || os_atomic_load(&piano_guard_milestone_ns, relaxed) != 0 ||
+	    !piano_guard_comm_is(comm, piano_guard_exec_name)) {
+		return;
+	}
+	uint64_t now = piano_guard_uptime_ns();
+	if (os_atomic_cmpxchg(&piano_guard_milestone_ns, 0ULL, now != 0 ? now : 1, relaxed)) {
+		printf("piano-boot-guard: exec of %s at %llu s (the milestone)\n", piano_guard_exec_name, now / NSEC_PER_SEC);
+	}
+}
+
+size_t
+piano_boot_guard_format(char *buf, size_t len)
+{
+	struct piano_guard_view v = {
+		.state = piano_guard_state, .secs = piano_guard_secs, .reset_after = piano_guard_reset_after,
+		.now_ms = piano_guard_uptime_ns() / NSEC_PER_MSEC, .decided_ms = piano_guard_decided_ns / NSEC_PER_MSEC,
+		.milestone_ms = os_atomic_load(&piano_guard_milestone_ns, relaxed) / NSEC_PER_MSEC,
+		.exec = piano_guard_need_exec ? piano_guard_exec_name : "", .reason = piano_guard_reason,
+		.reason_err = piano_guard_reason_err, .keep_reason = piano_guard_keep_reason, .wdt_on = piano_watchdog_enabled(),
+		.holders = piano_watchdog_holders(), .pinging = piano_guard_ping && !piano_guard_silent, .pings = piano_guard_pings,
+		.max_gap_ms = piano_guard_max_gap_ns / NSEC_PER_MSEC, .cpu_check = piano_guard_cpus, .stuck_cpu = piano_guard_stuck,
+		.hang_at = piano_guard_hang_at,
+	};
+	if (v.milestone_ms == 0 && os_atomic_load(&piano_guard_milestone_ns, relaxed) != 0) {
+		v.milestone_ms = 1;
+	}
+	return piano_guard_format(buf, len, &v);
+}
+
+static void
+piano_guard_log(void)
+{
+	char line[384];
+	(void)piano_boot_guard_format(line, sizeof(line));
+	printf("piano-boot-guard: %s", line);
+}
+
+/* Every other running CPU took an interrupt since the last tick (each gets a nop IPI per tick): -1, else the first one stuck. */
+static int
+piano_guard_check_cpus(void)
+{
+	int stuck = -1;
+	disable_preemption();
+	const int self = cpu_number();
+	for (int cpu = 0; cpu <= ml_get_max_cpu_number() && cpu < MAX_CPUS; cpu++) {
+		cpu_data_t *cdp = cpu_datap(cpu);
+		processor_t proc = cdp != NULL ? cpu_to_processor(cpu) : PROCESSOR_NULL;
+		bool up = cpu != self && proc != PROCESSOR_NULL && proc->state >= PROCESSOR_IDLE &&
+		    (os_atomic_load(&cdp->cpu_flags, relaxed) & (InitState | StartedState)) == (InitState | StartedState);
+		uint32_t irqs = up ? (uint32_t)os_atomic_load(&cdp->cpu_stat.irq_ex_cnt, relaxed) : 0;
+		if (piano_guard_cpu_quiet(irqs, &piano_guard_irqs[cpu], &piano_guard_quiet[cpu], piano_guard_poked[cpu], up) && stuck < 0) {
+			stuck = cpu;
+		}
+		piano_guard_poked[cpu] = up && cpu_signal(cdp, SIGPnop, NULL, NULL) == KERN_SUCCESS;
+	}
+	enable_preemption();
+	return stuck;
+}
+
+static void
+piano_guard_healthy(uint64_t now)
+{
+	piano_guard_decided_ns = now;
+	piano_guard_state = PIANO_GUARD_HEALTHY;
+	if (piano_guard_keep_reason) {
+		printf("piano-boot-guard: healthy after %u s, restart reason stays bootloader (piano-reset-to)\n", piano_guard_secs);
+	} else {
+		int err = piano_set_restart_reason(0, "piano-boot-guard");
+		piano_guard_reason_err = err;
+		if (err == 0) {
+			piano_guard_reason = 0;
+			printf("piano-boot-guard: healthy after %u s, restart reason normal\n", piano_guard_secs);
+		} else {
+			printf("piano-boot-guard: healthy after %u s, but the restart reason write failed (%d): it stays %s\n",
+			    piano_guard_secs, err, piano_guard_reason_name(piano_guard_reason));
+		}
+	}
+	piano_guard_log();
+}
+
+static void
+piano_guard_tick(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	const uint64_t now = piano_guard_uptime_ns(), deadline = (uint64_t)piano_guard_secs * NSEC_PER_SEC;
+	const char *into = piano_guard_reason == 2 ? "ABL fastboot" : "the installed system";
+	if (piano_guard_last_ns != 0 && now - piano_guard_last_ns > piano_guard_max_gap_ns) {
+		piano_guard_max_gap_ns = now - piano_guard_last_ns;
+	}
+	piano_guard_last_ns = now;
+	if (piano_guard_cpus && !piano_guard_silent) {
+		int stuck = piano_guard_check_cpus();
+		if (stuck >= 0) {
+			piano_guard_stuck = stuck;
+			piano_guard_silent = true;
+			printf("piano-boot-guard: CPU %d took no interrupt across %u ticks (a nop IPI each): hung; no more pings, PSCI reset "
+			    "into %s\n", stuck, PIANO_GUARD_QUIET_TICKS, into);
+			delay(200000);
+			piano_psci_reset();
+			return;   /* still here: no more pings, the watchdog bites within 32 s */
+		}
+	}
+	switch (piano_guard_decide(piano_guard_state, now, deadline, os_atomic_load(&piano_guard_milestone_ns, relaxed),
+	    piano_guard_need_exec)) {
+	case PIANO_GUARD_GO_HEALTHY:
+		piano_guard_healthy(now);
+		break;
+	case PIANO_GUARD_GO_FAILED:
+		piano_guard_decided_ns = now;
+		piano_guard_state = PIANO_GUARD_FAILED;
+		piano_guard_silent = true;
+		printf("piano-boot-guard: not healthy after %u s (no exec of %s yet): PSCI reset into %s\n", piano_guard_secs,
+		    piano_guard_exec_name, into);
+		piano_guard_log();
+		delay(200000);
+		piano_psci_reset();
+		return;   /* still here: no more pings, the watchdog bites within 32 s */
+	default:
+		break;
+	}
+	if (piano_guard_ping && !piano_guard_silent && piano_watchdog_enabled()) {
+		piano_watchdog_ping();
+		piano_guard_pings++;
+	}
+	uint64_t next = piano_guard_next(piano_guard_state, now, deadline, (uint64_t)PIANO_GUARD_PERIOD_S * NSEC_PER_SEC), delta;
+	nanoseconds_to_absolutetime(next - now, &delta);
+	thread_call_enter_delayed(piano_guard_call, mach_absolute_time() + delta);
+}
+
+/* piano-boot-guard-test=hang-at=N: what a hang is to the watchdog, on every CPU (cpu_broadcast_xcall, this one too). */
+__attribute__((noreturn))
+static void
+piano_guard_spin(void *arg __unused)
+{
+	(void)ml_set_interrupts_enabled(FALSE);
+	for (;;) {
+		__builtin_arm_wfe();
+	}
+}
+
+static void
+piano_guard_hang(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	if (!piano_watchdog_enabled()) {
+		printf("piano-boot-guard: test: the watchdog is off, so no CPU is stopped (nothing would reset the tablet)\n");
+		return;
+	}
+	piano_guard_silent = true;
+	printf("piano-boot-guard: test: every CPU stops now with interrupts masked (piano-boot-guard-test=hang-at=%u): the watchdog "
+	    "resets into %s within 32 s\n", piano_guard_hang_at, piano_guard_reason == 2 ? "ABL fastboot" : "the installed system");
+	delay(300000);
+	(void)cpu_broadcast_xcall(&piano_guard_spin_sync, TRUE, piano_guard_spin, &piano_guard_spin_sync);
+	piano_guard_spin(NULL);
+}
+
+static void
+piano_boot_guard_init(void)
+{
+	uint32_t secs = 0, ping = 1, cpus = 1, reset_after = 0;
+	if (!PE_parse_boot_argn("piano-boot-guard", &secs, sizeof(secs)) || secs == 0) {
+		return;
+	}
+	piano_guard_secs = secs;
+	if (PE_parse_boot_argn("piano-reset-after", &reset_after, sizeof(reset_after)) && reset_after != 0) {
+		piano_guard_state = PIANO_GUARD_DEFERRED;
+		piano_guard_reset_after = reset_after;
+		printf("piano-boot-guard: piano-reset-after=%u owns the watchdog and the restart reason: the guard stays off\n", reset_after);
+		return;
+	}
+	if (ml_psci_conduit != ML_PSCI_CONDUIT_SMC) {
+		piano_guard_state = PIANO_GUARD_NOT_NATIVE;
+		printf("piano-boot-guard: PSCI is not through SMC (ADT /psci): native only, the guard stays off\n");
+		return;
+	}
+	PE_parse_boot_argn("piano-boot-guard-ping", &ping, sizeof(ping));
+	PE_parse_boot_argn("piano-boot-guard-cpus", &cpus, sizeof(cpus));
+	piano_guard_ping = ping != 0;
+	piano_guard_cpus = cpus != 0;
+	char name[PIANO_GUARD_COMLEN + 1] = "";
+	if (PE_parse_boot_arg_str("piano-boot-guard-exec", name, (int)sizeof(name))) {
+		strlcpy(piano_guard_exec_name, name, sizeof(piano_guard_exec_name));
+	}
+	char to[16] = "";
+	piano_guard_keep_reason = PE_parse_boot_arg_str("piano-reset-to", to, (int)sizeof(to)) && strcmp(to, "bootloader") == 0;
+	char test[32] = "";
+	if (PE_parse_boot_arg_str("piano-boot-guard-test", test, (int)sizeof(test)) &&
+	    piano_guard_parse_test(test, &piano_guard_hang_at) != 0) {
+		printf("piano-boot-guard: piano-boot-guard-test=%s is not hang-at=N (N 1..86400 s): no test\n", test);
+	}
+	int err = piano_set_restart_reason(2, "piano-boot-guard");
+	piano_guard_reason_err = err;
+	if (err == 0) {
+		piano_guard_reason = 2;
+	} else {
+		printf("piano-boot-guard: the restart reason write failed (%d): a hang in the boot restarts the installed system\n", err);
+	}
+	const bool wdt = piano_watchdog_hold(PIANO_WDT_GUARD);
+	piano_guard_call = thread_call_allocate_with_options(piano_guard_tick, NULL, THREAD_CALL_PRIORITY_KERNEL_HIGH,
+	    THREAD_CALL_OPTIONS_ONCE);
+	piano_guard_need_exec = !piano_guard_exec_none(piano_guard_exec_name);
+	piano_guard_state = PIANO_GUARD_ARMED;
+	printf("piano-boot-guard: armed: restart reason %s until healthy, Gunyah watchdog %s, CPU check %s; health at %u s: %s%s, "
+	    "else a PSCI reset into ABL fastboot\n", piano_guard_reason_name(piano_guard_reason),
+	    wdt ? (piano_guard_ping ? "armed (32 s bite), pinged every 10 s" : "armed (32 s bite)") : "not available",
+	    piano_guard_cpus ? "on" : "off", secs, piano_guard_need_exec ? "the exec of " : "the uptime alone",
+	    piano_guard_need_exec ? piano_guard_exec_name : "");
+	if (wdt && !piano_guard_ping) {
+		printf("piano-boot-guard: test: no pings (piano-boot-guard-ping=0): the watchdog bites about 32 s from now, into %s\n",
+		    piano_guard_reason == 2 ? "ABL fastboot" : "the installed system");
+	}
+	if (piano_guard_hang_at != 0) {
+		piano_guard_test_call = thread_call_allocate_with_options(piano_guard_hang, NULL, THREAD_CALL_PRIORITY_KERNEL_HIGH,
+		    THREAD_CALL_OPTIONS_ONCE);
+		uint64_t now = piano_guard_uptime_ns(), when = (uint64_t)piano_guard_hang_at * NSEC_PER_SEC, delta;
+		nanoseconds_to_absolutetime(when > now ? when - now : 0, &delta);
+		thread_call_enter_delayed(piano_guard_test_call, mach_absolute_time() + delta);
+		printf("piano-boot-guard: test: every CPU stops at %u s (piano-boot-guard-test), %s the health decision\n",
+		    piano_guard_hang_at, piano_guard_hang_at < secs ? "before" : "after");
+	}
+	piano_guard_tick(NULL, NULL);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, piano_boot_guard_init);
