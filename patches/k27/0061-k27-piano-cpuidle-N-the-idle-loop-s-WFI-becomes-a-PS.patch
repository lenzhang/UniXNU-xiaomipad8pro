--- a/bsd/dev/arm64/sysctl.c
+++ b/bsd/dev/arm64/sysctl.c
@@ -110,6 +110,50 @@ SYSCTL_PROC(_machdep, OID_AUTO, wake_conttime,
     0, 0, sysctl_wake_conttime, "I",
     "Continuous Time at the last wakeup");
 
+#if defined(XNU_VM_GUEST)
+/* piano (k27 0061): the PSCI CPU idle counters (UniXNU-piano docs/power.md) */
+extern size_t piano_cpuidle_format(char *buf, size_t len);
+extern int piano_cpuidle_level(void);
+extern int piano_cpuidle_set_level(int level);
+
+static int
+sysctl_piano_cpuidle SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	const size_t len = 4096;
+	char *buf = kalloc_data(len, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	size_t n = piano_cpuidle_format(buf, len);
+	int error = SYSCTL_OUT(req, buf, n + 1);
+	kfree_data(buf, len);
+	return error;
+}
+
+SYSCTL_PROC(_machdep, OID_AUTO, piano_cpuidle,
+    CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_piano_cpuidle, "A",
+    "piano-cpuidle: entries and residency per CPU and state");
+
+static int
+sysctl_piano_cpuidle_level SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	int new_value = 0, changed = 0;
+	int error = sysctl_io_number(req, piano_cpuidle_level(), sizeof(int), &new_value, &changed);
+	if (error == 0 && changed) {
+		error = piano_cpuidle_set_level(new_value);
+	}
+	return error;
+}
+
+SYSCTL_PROC(_machdep, OID_AUTO, piano_cpuidle_level,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_piano_cpuidle_level, "I",
+    "piano-cpuidle: the deepest level in force (0 WFI .. the boot argument's level)");
+#endif /* defined(XNU_VM_GUEST) */
+
 #if defined(HAS_IPI)
 static int
 cpu_signal_deferred_timer(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
