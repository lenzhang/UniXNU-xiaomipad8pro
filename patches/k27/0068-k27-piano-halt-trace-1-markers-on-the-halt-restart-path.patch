From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UniXNU-piano
Date: Sat, 14 Nov 2026 21:30:00 +0800
Subject: [PATCH] k27: piano-halt-trace=1: markers on the halt/restart path

Every restart or shutdown of the tablet ends in "Halt/Restart Timed Out @IOPlatformExpert.cpp:884":
the 30 s thread call PEHaltRestartInternal arms before handlePlatformHaltRestart, whose ARM form
panics without the phase. With piano-halt-trace=1 (default 0: nothing changes) the console, and so
the pstore mailbox, gets "piano-halt: ..." lines that name the waiter:
- PEHaltRestart's entry and handlePlatformHaltRestart's return; the platform's haltRestart (its
  class, whether PE_halt_restart is set) and its return;
- each phase of handlePlatformHaltRestart with its uptime, NVRAM sync before and after, every
  priority client handler before and after, notifySystemShutdown's return;
- the halt/restart platform actions: how many, each one's return (the kernel already logs the entry),
  and the end of the walk;
- the PM quiesce: quiescePowerTree's result, the request's attachment with the work queue's length,
  every quiesce-blocking request attached (at the start and later) and retired with its target and
  type, the request's retirement, the callback, "PM quiesced";
- halt_all_cpus: the PSCI SYSTEM_OFF/SYSTEM_RESET call and its signed result if it returns;
- at the timeout: the uptime, then IOPMrootDomain::panicWithShutdownLog (the phase that did not end,
  as the x86 kernel panics) instead of the bare panic.
---
diff --git a/iokit/Kernel/IOPMrootDomain.cpp b/iokit/Kernel/IOPMrootDomain.cpp
--- a/iokit/Kernel/IOPMrootDomain.cpp
+++ b/iokit/Kernel/IOPMrootDomain.cpp
@@ -6044,6 +6044,17 @@
 	IOServiceInterestHandler    handler;
 } gHaltRestartCtx;
 
+
+/* k27 0068: piano-halt-trace=1 (osfmk/arm64/machine_routines.c): markers on the halt/restart path, to the console */
+extern "C" uint32_t piano_halt_trace;
+static inline uint64_t
+piano_halt_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000;
+}
+
 const char *
 shutdownPhase2String(shutdownPhase_t phase)
 {
@@ -6086,8 +6097,14 @@
 	}
 
 	clock_get_uptime(&startTime);
+	if (piano_halt_trace) {
+		printf("piano-halt: priority client %u handler %p ->\n", ctx->Counter, notifier ? (void *)VM_KERNEL_UNSLIDE(notifier->handler) : NULL);
+	}
 	ctx->RootDomain->messageClient( ctx->MessageType, object, (void *)&notify );
 	deltaTime = computeDeltaTimeMS(&startTime, &elapsedTime);
+	if (piano_halt_trace) {
+		printf("piano-halt: priority client %u returned after %u ms\n", ctx->Counter, deltaTime);
+	}
 
 	if ((deltaTime > kPMHaltTimeoutMS) && notifier) {
 		LOG("%s handler %p took %u ms\n",
@@ -6102,6 +6119,9 @@
 static void
 quiescePowerTreeCallback( void * target, void * param )
 {
+	if (piano_halt_trace) {
+		printf("piano-halt: PM quiesce callback at t=%llu ms\n", piano_halt_ms());
+	}
 	IOLockLock(gPMHaltLock);
 	gPMQuiesced = true;
 	thread_wakeup(param);
@@ -6150,10 +6170,19 @@
 	}
 
 	if (nvramSync) {
+		if (piano_halt_trace) {
+			printf("piano-halt: %s: NVRAM sync ->\n", gHaltRestartCtx.LogString);
+		}
 		PESyncNVRAM();
+		if (piano_halt_trace) {
+			printf("piano-halt: NVRAM sync returned at t=%llu ms\n", piano_halt_ms());
+		}
 	}
 
 	gHaltRestartCtx.phase = kNotifyPriorityClients;
+	if (piano_halt_trace) {
+		printf("piano-halt: phase '%s' at t=%llu ms\n", shutdownPhase2String(gHaltRestartCtx.phase), piano_halt_ms());
+	}
 	// Notify legacy clients
 	applyToInterested(gIOPriorityPowerStateInterest, platformHaltRestartApplier, &gHaltRestartCtx);
 
@@ -6168,11 +6197,20 @@
 
 	if (kPEPagingOff != pe_type) {
 		gHaltRestartCtx.phase = kNotifyPowerPlaneDrivers;
+		if (piano_halt_trace) {
+			printf("piano-halt: phase '%s' at t=%llu ms\n", shutdownPhase2String(gHaltRestartCtx.phase), piano_halt_ms());
+		}
 		// Notify in power tree order
 		notifySystemShutdown(this, gHaltRestartCtx.MessageType);
+		if (piano_halt_trace) {
+			printf("piano-halt: notifySystemShutdown returned at t=%llu ms\n", piano_halt_ms());
+		}
 	}
 
 	gHaltRestartCtx.phase = kNotifyHaltRestartAction;
+	if (piano_halt_trace) {
+		printf("piano-halt: phase '%s' at t=%llu ms\n", shutdownPhase2String(gHaltRestartCtx.phase), piano_halt_ms());
+	}
 #if defined(XNU_TARGET_OS_OSX)
 	IOCPURunPlatformHaltRestartActions(pe_type);
 #else /* !defined(XNU_TARGET_OS_OSX) */
@@ -6185,16 +6223,25 @@
 	if ((kPEPagingOff != pe_type) && gPMHaltLock) {
 		gHaltRestartCtx.phase = kQuiescePM;
 		AbsoluteTime quiesceTime = mach_absolute_time();
+		if (piano_halt_trace) {
+			printf("piano-halt: phase '%s' at t=%llu ms\n", shutdownPhase2String(gHaltRestartCtx.phase), piano_halt_ms());
+		}
 
 		IOLockLock(gPMHaltLock);
 		gPMQuiesced = false;
-		if (quiescePowerTree(this, &quiescePowerTreeCallback, &gPMQuiesced) ==
-		    kIOReturnSuccess) {
+		IOReturn piano_quiesce = quiescePowerTree(this, &quiescePowerTreeCallback, &gPMQuiesced);
+		if (piano_halt_trace) {
+			printf("piano-halt: quiescePowerTree returned 0x%x; waiting for the callback\n", piano_quiesce);
+		}
+		if (piano_quiesce == kIOReturnSuccess) {
 			while (!gPMQuiesced) {
 				IOLockSleep(gPMHaltLock, &gPMQuiesced, THREAD_UNINT);
 			}
 		}
 		IOLockUnlock(gPMHaltLock);
+		if (piano_halt_trace) {
+			printf("piano-halt: PM quiesced at t=%llu ms\n", piano_halt_ms());
+		}
 		deltaTime = computeDeltaTimeMS(&quiesceTime, &elapsedTime);
 		DLOG("PM quiesce took %u ms\n", deltaTime);
 		halt_log_enter("Quiesce", NULL, elapsedTime);
