+/* k27 0068: piano-halt-trace=1 (osfmk/arm64/machine_routines.c): markers on the halt/restart path, to the console */
+extern "C" uint32_t piano_halt_trace;
+static inline uint64_t
+piano_halt_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
