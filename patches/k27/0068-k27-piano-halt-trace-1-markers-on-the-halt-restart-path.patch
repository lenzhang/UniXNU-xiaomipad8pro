+	}
 	return iocpu_run_platform_actions(&gActionQueues[kQueueHaltRestart], 0, 0U - 1,
 	           (void *)(uintptr_t) message, NULL, NULL, PLATFORM_ACTION_FLAGS_ALLOW_NESTED_CALLOUTS);
 }
@@ -264,6 +286,9 @@
 
 	ret = service->callPlatformFunction(function, false,
