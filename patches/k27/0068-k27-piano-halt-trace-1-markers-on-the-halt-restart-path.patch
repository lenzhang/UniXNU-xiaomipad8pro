+
 /* IOShutdownNotificationsTimedOut
  * - Called from a timer installed by PEHaltRestart
  */
@@ -880,6 +891,14 @@
 	thread_call_param_t p1)
 {
 #if !defined(__x86_64__)
+	/* k27 0068: with piano-halt-trace=1 the phase that did not end (IOPMrootDomain's own log, as x86 panics) */
+	if (piano_halt_trace) {
+		IOPMrootDomain *pmRootDomain = IOService::getPMRootDomain();
+		printf("piano-halt: timed out after %u s at t=%llu ms\n", (uint32_t)(uintptr_t)p1, piano_halt_ms());
+		if (pmRootDomain) {
+			pmRootDomain->panicWithShutdownLog((uint32_t)(uintptr_t)p1 * 1000);
+		}
+	}
 	/* 30 seconds has elapsed - panic */
 	panic("Halt/Restart Timed Out");
 
@@ -1053,7 +1072,15 @@
 			thread_call_enter1_delayed( shutdown_hang, (thread_call_param_t)(uintptr_t)timeout, deadline );
 		}
 
+		uint64_t piano_halt_start = piano_halt_ms();
+		if (piano_halt_trace) {
+			printf("piano-halt: PEHaltRestart type %u at t=%llu ms (timeout %u s): handlePlatformHaltRestart ->\n", type,
+			    piano_halt_start, timeout);
+		}
 		pmRootDomain->handlePlatformHaltRestart(type);
+		if (piano_halt_trace) {
+			printf("piano-halt: handlePlatformHaltRestart returned after %llu ms\n", piano_halt_ms() - piano_halt_start);
+		}
 		/* This notification should have few clients who all do
 		 *  their work synchronously.
 		 *
@@ -1108,6 +1135,13 @@
 	if (gIOPlatform) {
 		// note that this will not necessarily halt or restart the system...
 		// Implementors of this function will check the type and take action accordingly
