diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1601,6 +1601,15 @@
 	return 0;
 }
 #endif /* defined(XNU_VM_GUEST) */
+
+/*
+ * k27 0068: piano-halt-trace=1. Markers on the halt/restart path ("piano-halt: ..." on the console, so the pstore mailbox keeps
+ * them): PEHaltRestart's entry and exit, each phase of IOPMrootDomain::handlePlatformHaltRestart, every priority client and
+ * halt/restart platform action with its return, the IOPM quiesce request and every request that blocks it (attach and retire),
+ * the platform's haltRestart, here the PSCI call and its result if it returns; at the 30 s timeout the phase that did not end.
+ * Off by default: nothing changes.
+ */
+TUNABLE(uint32_t, piano_halt_trace, "piano-halt-trace", 0);
 
 __attribute__((noreturn))
 void
@@ -1621,12 +1630,21 @@
 	 * SMC, which Gunyah does not route to PSCI. Natively (the HLOS at EL1) it is "smc", the firmware's PSCI.
 	 */
 	{
+		if (piano_halt_trace) {
+			printf("piano-halt: PSCI %s (0x%x) through %s\n", reboot ? "SYSTEM_RESET" : "SYSTEM_OFF", reboot ? 0x84000009U : 0x84000008U,
+			    ml_psci_conduit == ML_PSCI_CONDUIT_SMC ? "smc" : "hvc");
+			__builtin_arm_dsb(0xf);
+		}
 		register uint64_t x0 __asm__("x0") = reboot ? 0x84000009ULL : 0x84000008ULL;
 		if (ml_psci_conduit == ML_PSCI_CONDUIT_SMC) {
 			__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
 		} else {
 			__asm__ volatile ("hvc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
 		}
+		if (piano_halt_trace) {
+			printf("piano-halt: PSCI %s returned %d\n", reboot ? "SYSTEM_RESET" : "SYSTEM_OFF", (int32_t)x0);
+			__builtin_arm_dsb(0xf);
+		}
 	}
 #endif
 	while (1) {
