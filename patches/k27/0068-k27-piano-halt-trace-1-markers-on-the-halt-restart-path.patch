+			printf("piano-halt: %s::haltRestart(%u) -> (PE_halt_restart %s) at t=%llu ms\n", gIOPlatform->getMetaClass()->getClassName(),
+			    type, PE_halt_restart ? "set" : "NULL", piano_halt_ms());
+			int piano_ret = gIOPlatform->haltRestart(type);
+			printf("piano-halt: haltRestart returned %d at t=%llu ms\n", piano_ret, piano_halt_ms());
+			return piano_ret;
+		}
 		return gIOPlatform->haltRestart(type);
 	} else {
 		return -1;
