@@ -6,6 +6,7 @@
 Handles the relocation kinds clang emits for kernel code: BRANCH26, PAGE21,
 PAGEOFF12, GOT_LOAD_PAGE21/PAGEOFF12, ADDEND, UNSIGNED and AUTHENTICATED_POINTER.
 """
+import os
 import struct
 
 UNSIGNED, SUBTRACTOR, BRANCH26, PAGE21, PAGEOFF12, GOT_PAGE21, GOT_PAGEOFF12, POINTER_TO_GOT, TLVP_PAGE21, TLVP_PAGEOFF12, ADDEND, AUTH = range(12)
@@ -32,8 +33,20 @@
     ('__DATA', '__common'): ('__DATA', '__common'),
 }
 SEGMENT_ORDER = ['__TEXT', '__TEXT_EXEC', '__DATA_CONST', '__DATA']
+# KC_NATIVE_CONST_TO_TEXT=1: constant data without relocations (a firmware image, a table of numbers) needs no chained fixup, so it
+# goes to the kext's __TEXT,__const (read only, as __DATA_CONST is after boot) instead of __DATA_CONST,__const, where a collection
+# keeps little room. Off by default (as before).
+CONST_TO_TEXT = os.environ.get('KC_NATIVE_CONST_TO_TEXT', '0') == '1'
 
 
+def kext_section(sect):
+    """(segment, section) of the kext that an object's section goes to."""
+    seg, name = PLACEMENT[(sect['segment'], sect['name'])]
+    if CONST_TO_TEXT and (seg, name) == ('__DATA_CONST', '__const') and not sect['nreloc']:
+        return '__TEXT', '__const'
+    return seg, name
+
+
 class LinkError(Exception):
     pass
 
