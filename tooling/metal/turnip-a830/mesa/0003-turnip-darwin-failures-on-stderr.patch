+static kern_return_t
+dw_call(uint32_t method, const void *in, size_t in_size, void *out,
+        size_t out_size)
+{
+   if (dw.virtgpu)
+      return dwv_call(method, in, in_size, out, out_size);
+   const kern_return_t kr = dw_call_native(method, in, in_size, out, out_size);
+   if (kr != KERN_SUCCESS)
