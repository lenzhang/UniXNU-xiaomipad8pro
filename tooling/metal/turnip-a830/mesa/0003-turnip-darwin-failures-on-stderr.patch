+static const char *
+dw_method_name(uint32_t method)
+{
+   switch (method) {
+   case NativeAdrenoMethodQuery: return "Query";
+   case NativeAdrenoMethodBoAlloc: return "BoAlloc";
+   case NativeAdrenoMethodBoMap: return "BoMap";
+   case NativeAdrenoMethodBoFree: return "BoFree";
+   case NativeAdrenoMethodSubmit: return "Submit";
+   case NativeAdrenoMethodWaitFence: return "WaitFence";
+   case NativeAdrenoMethodGetTimestamp: return "GetTimestamp";
+   case NativeAdrenoMethodGetStatus: return "GetStatus";
+   case NativeAdrenoMethodSetMetadata: return "SetMetadata";
+   case NativeAdrenoMethodGetMetadata: return "GetMetadata";
+   case NativeAdrenoMethodCreateQueue: return "CreateQueue";
+   case NativeAdrenoMethodCloseQueue: return "CloseQueue";
+   case NativeAdrenoMethodBoCpuMap: return "BoCpuMap";
+   case NativeAdrenoMethodBoCpuUnmap: return "BoCpuUnmap";
+   case NativeAdrenoMethodGetDeviceInfo: return "GetDeviceInfo";
+   case NativeAdrenoMethodBoImport: return "BoImport";
+   default: return NULL;
+   }
+}
+
+/* The first failure of each kernel method and status in this process on stderr, then its 10th, 100th, ... (a call that keeps failing
+ * stays visible without a line per call), where a Metal client's line reaches the kernel console (stderr-log=1): the release build's
+ * vk_log says nothing, and a refused allocation is otherwise only an out-of-memory answer to the runtime. The answers the backend
+ * expects are left out: a fence wait's slice that timed out, a full ring or a BO still busy (both retried), no status counters. */
+static void
+dw_note_failure(uint32_t method, kern_return_t kr)
+{
+   if ((method == NativeAdrenoMethodWaitFence && kr == kIOReturnTimeout) ||
+       ((method == NativeAdrenoMethodSubmit || method == NativeAdrenoMethodBoFree) && kr == kIOReturnBusy) ||
+       (method == NativeAdrenoMethodGetStatus && kr == kIOReturnUnsupported))
+      return;
+   static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+   static struct { uint32_t method; kern_return_t kr; uint64_t count; } seen[32];
+   static uint64_t others;
+   uint64_t count;
+   pthread_mutex_lock(&lock);
+   unsigned i = 0;
+   while (i < 32 && seen[i].count && (seen[i].method != method || seen[i].kr != kr))
+      i++;
+   if (i < 32) {
+      seen[i].method = method;
+      seen[i].kr = kr;
+      count = ++seen[i].count;
+   } else {
+      count = ++others;
+   }
+   pthread_mutex_unlock(&lock);
+   uint64_t mark = 1;
+   while (mark < count)
+      mark *= 10;
+   if (mark != count)
+      return;
+   const char *name = dw_method_name(method);
+   if (name)
+      mesa_loge("NativeAdreno: kernel %s failed: 0x%x (%llu time%s)", name, kr, (unsigned long long)count, count == 1 ? "" : "s");
+   else
+      mesa_loge("NativeAdreno: kernel method %u failed: 0x%x (%llu time%s)", method, kr, (unsigned long long)count,
+                count == 1 ? "" : "s");
+}
