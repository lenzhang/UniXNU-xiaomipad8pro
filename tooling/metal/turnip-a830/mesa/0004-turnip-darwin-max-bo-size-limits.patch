 /* ---- buffer objects ---- */
 
+/* A BO past the kernel's per-object limit (max_bo_size, Query's max_bo_bytes) is refused here, as maxMemoryAllocationSize says, instead
+ * of a kernel BadArgument; the first such request and then every 10th, 100th, ... is named on stderr. */
+static bool
+darwin_past_bo_limit(struct tu_device *dev, uint64_t size, const char *what)
+{
+   const uint64_t limit = dev->physical_device->max_bo_size;
+   if (!limit || size <= limit)
+      return false;
+   static uint64_t refusals;
+   const uint64_t refused = p_atomic_inc_return(&refusals);
+   uint64_t mark = 1;
+   while (mark < refused)
+      mark *= 10;
+   if (mark == refused)
+      mesa_loge("NativeAdreno: a %s of %llu MiB is past the kernel's per-object limit of %llu MiB (maxMemoryAllocationSize); refused "
+                "(%llu time%s)", what, (unsigned long long)((size + (1u << 20) - 1) >> 20), (unsigned long long)(limit >> 20),
+                (unsigned long long)refused, refused == 1 ? "" : "s");
+   return true;
+}
+
