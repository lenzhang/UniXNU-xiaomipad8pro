 /* ---- buffer objects ---- */
 
+/* The largest BO this connection can use (2026-11-12): the kernel's per-object limit (Query's max_bo_bytes: Adreno830 upstream 256 MiB,
+ * piano's macOS kernel its GPU window), and never more than the window GetDeviceInfo gave it, which every BO must be mapped in. The
+ * memory allocation, buffer and image resource limits are capped at it (max_bo_size, 0004); a larger BO is refused before the kernel. */
+static uint64_t
+darwin_object_limit(void)
+{
+   uint64_t limit = dw.params.max_bo_bytes;
+   if (dw.info.va_size && dw.info.va_size < limit)
+      limit = dw.info.va_size;
+   return limit & ~(uint64_t)4095;
+}
+
+/* The physical device whose limits tu_darwin_limits answers (one per process). */
+static struct tu_physical_device *darwin_limits_device;
+
+/* The limits this process's allocations meet, for the Metal frontend's answers and its console line (frontend 0003): [0] the kernel's
+ * per-object limit (Query's max_bo_bytes), [1] the device's GPU window, [2] Turnip's per-object limit (max_bo_size:
+ * maxMemoryAllocationSize, maxBufferSize, images' maxResourceSize), [3] the memory heap, [4] maxImageDimension1D, [5] 2D, [6] 3D,
+ * [7] cube, [8] maxImageArrayLayers, [9] maxTexelBufferElements, [10] maxMemoryAllocationSize as reported, [11] 0. All 0 before a
+ * physical device exists. */
+extern "C" __attribute__((visibility("default"))) void tu_darwin_limits(uint64_t out[12]);
+extern "C" __attribute__((visibility("default"))) void
+tu_darwin_limits(uint64_t out[12])
+{
+   memset(out, 0, 12 * sizeof(uint64_t));
+   const struct tu_physical_device *pdev = darwin_limits_device;
+   if (!pdev)
+      return;
+   const struct vk_properties *props = &pdev->vk.properties;
+   out[0] = dw.params.max_bo_bytes;
+   out[1] = pdev->va_size;
+   out[2] = pdev->max_bo_size;
+   out[3] = pdev->heap.size;
+   out[4] = props->maxImageDimension1D;
+   out[5] = props->maxImageDimension2D;
+   out[6] = props->maxImageDimension3D;
+   out[7] = props->maxImageDimensionCube;
+   out[8] = props->maxImageArrayLayers;
+   out[9] = props->maxTexelBufferElements;
+   out[10] = props->maxMemoryAllocationSize;
+}
+
+/* A BO of 256 MiB or more on stderr, each one larger than every one before it in this process: what the per-object limit and the
+ * memory are up against (a 16384x16384 texture is 1 GiB at 4 bytes a texel). */
+static void
+darwin_note_large_bo(struct tu_device *dev, uint64_t size)
+{
+   static uint64_t largest;
+   if (size < ((uint64_t)256 << 20))
+      return;
+   for (uint64_t seen = p_atomic_read(&largest); size > seen; seen = p_atomic_read(&largest)) {
+      if (p_atomic_cmpxchg(&largest, seen, size) != seen)
+         continue;
+      mesa_logi("NativeAdreno: a BO of %llu MiB, the largest so far (per-object limit %llu MiB, GPU window %llu MiB)",
+                (unsigned long long)((size + (1u << 20) - 1) >> 20), (unsigned long long)(dev->physical_device->max_bo_size >> 20),
+                (unsigned long long)(dev->physical_device->va_size >> 20));
+      return;
+   }
+}
+
