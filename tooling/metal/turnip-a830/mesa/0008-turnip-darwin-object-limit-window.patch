+                (unsigned long long)(limit >> 20), (unsigned long long)(dw.params.max_bo_bytes >> 20),
+                (unsigned long long)(dev->physical_device->va_size >> 20), (unsigned long long)refused, refused == 1 ? "" : "s");
    return true;
 }
 
