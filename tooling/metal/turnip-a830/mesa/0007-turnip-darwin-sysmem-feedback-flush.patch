+
+/* UniXNU-piano (Turnip 0007): a draw that reads the attachments it renders to (Metal's framebuffer fetch, which metal2vulkan lowers
+ * to input attachments of the pass: Core Animation's glass, backdrop and vibrancy draws) sees, in a GMEM pass, the earlier draws' pixels
+ * in GMEM. In a sysmem pass it reads the image through UCHE while those pixels may still be in the CCU, and then only SINGLE_PRIM_MODE
+ * (FLUSH_PER_OVERLAP_AND_OVERWRITE, tu6_emit_prim_mode_sysmem), a6xx's mechanism that nothing has checked on the A830, keeps the two in
+ * step. So before each such draw a sysmem pass cleans the CCU, invalidates UCHE and waits for the writes (CP_COND_REG_EXEC on the
+ * render mode: GMEM passes and the binning pass skip it). TU_DEBUG=nofbflush leaves it out (the A/B). */
+static const char *
+tu_draw_reads_own_attachments(const struct tu_cmd_buffer *cmd)
+{
+   const struct tu_shader *fs = cmd->state.shaders[MESA_SHADER_FRAGMENT];
+   if (fs && fs->fs.dynamic_input_attachments_used)
+      return "input attachments of a dynamic pass";
+   /* metal2vulkan declares the colour attachments as input attachments of every subpass, with the feedback-loop and
+    * rasterization-order flags on every pipeline, so those flags alone would put the flush before every draw. A fragment shader
+    * that reads an input attachment of the subpass is one with non-bindless texture slots (build_bindless: input attachments are
+    * the only descriptors that take them), hence ir3's num_samp. TU_DEBUG=fbflushall takes the flags as they are. */
+   if (fs && fs->variant && fs->variant->num_samp > 0 && cmd->state.subpass && cmd->state.subpass->input_count)
+      return "input attachments of the subpass";
+   if (!TU_DEBUG(FB_FLUSH_ALL))
+      return NULL;
+   if (cmd->state.subpass && (cmd->state.subpass->feedback_loop_color || cmd->state.subpass->feedback_loop_ds))
+      return "a subpass whose input attachment is also its colour or depth attachment (fbflushall)";
+   if (cmd->state.raster_order_attachment_access)
+      return "rasterization-order attachment access (fbflushall)";
+   if (cmd->state.pipeline_feedback_loops || cmd->vk.dynamic_graphics_state.feedback_loops)
+      return "an attachment feedback loop (fbflushall)";
+   return NULL;
+}
+
+template <chip CHIP>
+static void
+tu_sysmem_feedback_flush(struct tu_cmd_buffer *cmd, struct tu_cs *cs, const char *why)
+{
+   static bool told;
+   if (!told) {
+      told = true;
+      mesa_logi("draws that read the attachments they render to (first: %s): in a sysmem pass each waits for the colour and depth "
+                "writes before it (0007; TU_DEBUG=nofbflush leaves it out)", why);
    }
+   /* tu6_emit_flushes' order for CCU_CLEAN_COLOR | CCU_CLEAN_DEPTH | CACHE_INVALIDATE | BLIT_CACHE_CLEAN | WAIT_MEM_WRITES |
+    * WAIT_FOR_IDLE | WAIT_FOR_ME. */
+   tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(RENDER_MODE) | CP_COND_REG_EXEC_0_SYSMEM);
+   tu_emit_event_write<CHIP>(cmd, cs, FD_CCU_CLEAN_COLOR);
+   tu_emit_event_write<CHIP>(cmd, cs, FD_CCU_CLEAN_DEPTH);
+   tu_emit_event_write<CHIP>(cmd, cs, FD_CACHE_INVALIDATE);
+   if (CHIP >= A7XX)
+      tu_emit_event_write<CHIP>(cmd, cs, FD_CCU_CLEAN_BLIT_CACHE);
+   tu_cs_emit_pkt7(cs, CP_WAIT_MEM_WRITES, 0);
+   tu_cs_emit_wfi(cs);
+   tu_cs_emit_pkt7(cs, CP_WAIT_FOR_ME, 0);
+   tu_cond_exec_end(cs);
 }
 
