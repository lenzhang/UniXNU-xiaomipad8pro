<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- UniXNU-piano: the still login wallpaper on the installed system (docs/drivers/gpu-userspace.md, "The wallpaper of the test
     images"; docs/persistent-boot.md section 11.6). Install as /Library/LaunchDaemons/com.unixnu.piano-still-wallpaper.plist
     (root:wheel 644) with the script at /usr/local/libexec/piano-still-wallpaper (tooling/k27/still-wallpaper.sh, root:wheel 755) and
     its three files in /usr/local/share/piano/wallpaper: configs/userland.toml, docs/userland.md. One run per boot (LaunchOnlyOnce),
     as root: it writes the login window's picture for every local account that has none, and replaces nothing that exists. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.unixnu.piano-still-wallpaper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/usr/local/libexec/piano-still-wallpaper</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>LaunchOnlyOnce</key><true/>
  <key>StandardOutPath</key><string>/private/var/log/piano-still-wallpaper.log</string>
  <key>StandardErrorPath</key><string>/private/var/log/piano-still-wallpaper.log</string>
</dict>
</plist>
