<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- piano-wifi-join (docs/drivers/wifi.md section 13.2): hands PianoWifi the join profile once at boot, from the root-only
     file /private/var/db/piano-wifi/profile, through the root-only sysctl machdep.piano_wifi_join. Exits at once when there
     is no profile or no PianoWifi; never keeps the secret after it exits. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.unixnu.piano-wifi-join</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/piano-wifi-join</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/private/var/log/piano-wifi-join.log</string>
  <key>StandardErrorPath</key>
  <string>/private/var/log/piano-wifi-join.log</string>
</dict>
</plist>
