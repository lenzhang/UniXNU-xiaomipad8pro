{
  "name": "PianoUsbHostStack",
  "bundle": "com.unixnu.driver.PianoUsbHostStack",
  "version": "1.0.0",
  "libraries": {
    "com.apple.driver.usb.AppleUSBXHCI": "1.2",
    "com.apple.iokit.IOUSBHostFamily": "1.2",
    "com.apple.driver.usb.AppleUSBHub": "1.2",
    "com.apple.driver.usb.AppleUSBHostCompositeDevice": "1.2",
    "com.apple.driver.usb.IOUSBHostHIDDevice": "1.2",
    "com.apple.iokit.IOUSBMassStorageDriver": "283",
    "com.apple.driver.usb.cdc.ncm": "5.0.0",
    "com.apple.driver.usb.cdc.ecm": "5.0.0",
    "com.apple.driver.usb.ethernet.asix": "5.0.0"
  },
  "personalities": {
    "AppleUSBXHCI on PianoUsbHostNub": {
      "CFBundleIdentifier": "com.apple.driver.usb.AppleUSBXHCI",
      "IOClass": "AppleUSBXHCI",
      "IOProviderClass": "PianoUsbHostNub",
      "IONameMatch": "usb-host0",
      "IOProbeScore": 1000
    }
  },
  "patch_personalities": {
    "com.apple.iokit.IOUSBHostFamily": {
      "AppleUSBHostResources": {
        "IOResourceMatch": "PianoUsbHostStack"
      },
      "AppleUSBHostResourcesTypeC": {
        "IOResourceMatch": "PianoUsbHostStack"
      }
    },
    "com.apple.iokit.IOUSBMassStorageDriver": {
      "IOUSBMassStorageResource": {
        "IOResourceMatch": "PianoUsbHostStack"
      }
    }
  }
}
